---
import logo from "../assets/toguchi-logo.svg";
const links = [
	{ href: "#servicios", label: "Servicios" },
	{ href: "#nosotros", label: "Nosotros" },
	{ href: "#portafolio", label: "Portafolio" },
	{ href: "#contacto", label: "Contacto" },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-darker/95 backdrop-blur">
	<nav class="mx-auto flex h-20 max-w-6xl items-center justify-between px-4 sm:px-6" aria-label="Principal">
		<a href="/" class="flex items-center" aria-label="TOGUCHI Ingeniería y Servicios — inicio">
			<img src={logo.src} alt="TOGUCHI Ingeniería & Servicios" class="h-14 w-auto" width="1920" height="448" />
		</a>
		<ul class="hidden items-center gap-8 md:flex">
			{links.map((l) => (
				<li>
					<a href={l.href} class="text-sm font-medium text-silver transition-colors hover:text-primary">{l.label}</a>
				</li>
			))}
		</ul>
		<a
			href="https://wa.me/51936013255?text=Hola%2C%20me%20interesa%20cotizar%20un%20proyecto"
			target="_blank"
			rel="noopener"
			class="rounded-md bg-primary px-4 py-2 text-sm font-semibold text-darker transition-opacity hover:opacity-90"
		>Hablemos</a>
	</nav>
</header>
