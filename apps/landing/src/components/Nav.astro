---
import logo from "../assets/toguchi-logo.svg";
const links = [
	{ href: "#servicios", label: "Servicios" },
	{ href: "#nosotros", label: "Nosotros" },
	{ href: "#portafolio", label: "Portafolio" },
	{ href: "#contacto", label: "Contacto" },
];
const wa = "https://wa.me/51936013255?text=Hola%2C%20me%20interesa%20cotizar%20un%20proyecto";
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-darker/95 backdrop-blur">
	<nav class="mx-auto flex h-20 max-w-6xl items-center justify-between px-4 sm:px-6" aria-label="Principal">
		<a href="/" class="flex items-center" aria-label="TOGUCHI Ingeniería y Servicios — inicio">
			<img src={logo.src} alt="TOGUCHI Ingeniería & Servicios" class="h-14 w-auto" width="1920" height="448" />
		</a>

		<ul class="hidden items-center gap-8 md:flex">
			{links.map((l) => (
				<li>
					<a href={l.href} class="text-sm font-medium text-silver transition-colors hover:text-primary">{l.label}</a>
				</li>
			))}
		</ul>

		<div class="flex items-center gap-3">
			<a
				href={wa}
				target="_blank"
				rel="noopener"
				class="hidden rounded-md bg-primary px-4 py-2 text-sm font-semibold text-darker transition-opacity hover:opacity-90 sm:inline-block"
			>Hablemos</a>

			<button
				type="button"
				id="menu-toggle"
				aria-label="Abrir menú"
				aria-expanded="false"
				aria-controls="menu-movil"
				class="flex h-10 w-10 items-center justify-center rounded-md border border-white/15 text-silver transition-colors hover:border-primary hover:text-primary md:hidden"
			>
				<svg id="icon-abrir" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<line x1="3" y1="7" x2="21" y2="7"></line>
					<line x1="3" y1="12" x2="21" y2="12"></line>
					<line x1="3" y1="17" x2="21" y2="17"></line>
				</svg>
				<svg id="icon-cerrar" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden" aria-hidden="true">
					<line x1="5" y1="5" x2="19" y2="19"></line>
					<line x1="19" y1="5" x2="5" y2="19"></line>
				</svg>
			</button>
		</div>
	</nav>

	<div id="menu-movil" class="hidden border-t border-white/10 bg-darker md:hidden">
		<ul class="mx-auto max-w-6xl px-4 py-4 sm:px-6">
			{links.map((l) => (
				<li>
					<a href={l.href} data-cerrar class="block border-b border-white/5 py-4 text-base font-medium text-silver transition-colors hover:text-primary">{l.label}</a>
				</li>
			))}
			<li class="pt-5">
				<a
					href={wa}
					target="_blank"
					rel="noopener"
					data-cerrar
					class="block rounded-md bg-primary px-6 py-3 text-center text-base font-semibold text-darker transition-opacity hover:opacity-90"
				>Hablemos de tu proyecto</a>
			</li>
		</ul>
	</div>
</header>

<script>
	const toggle = document.getElementById("menu-toggle");
	const menu = document.getElementById("menu-movil");
	const iconAbrir = document.getElementById("icon-abrir");
	const iconCerrar = document.getElementById("icon-cerrar");

	function setMenu(abierto: boolean) {
		if (!menu || !toggle) return;
		menu.classList.toggle("hidden", !abierto);
		iconAbrir?.classList.toggle("hidden", abierto);
		iconCerrar?.classList.toggle("hidden", !abierto);
		toggle.setAttribute("aria-expanded", String(abierto));
		toggle.setAttribute("aria-label", abierto ? "Cerrar menú" : "Abrir menú");
		document.body.style.overflow = abierto ? "hidden" : "";
	}

	toggle?.addEventListener("click", () => {
		setMenu(menu?.classList.contains("hidden") ?? true);
	});

	menu?.querySelectorAll("[data-cerrar]").forEach((el) => {
		el.addEventListener("click", () => setMenu(false));
	});

	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape" && !menu?.classList.contains("hidden")) {
			setMenu(false);
			(toggle as HTMLElement)?.focus();
		}
	});

	window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
		if (e.matches) setMenu(false);
	});
</script>
