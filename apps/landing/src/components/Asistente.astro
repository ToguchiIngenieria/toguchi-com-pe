---
/**
 * Asistente.astro — asistente de contacto GUIADO, como chat emergente. Sin LLM.
 *
 * Vive una sola vez en BaseLayout, anclado abajo a la derecha, y reemplaza al
 * boton flotante de WhatsApp. Tiene dos puntos de entrada y una sola
 * conversacion: la burbuja flotante y el boton «Iniciar conversacion» de la
 * seccion de contacto, que abre esta misma ventana por
 * `[data-asistente-abrir]`.
 *
 * El flujo es un automata determinista por botones: no hay generacion de
 * texto, no hay llamada a ningun modelo, y el asistente NUNCA entrega precios,
 * plazos ni compromisos. Solo recoge datos y los deriva.
 *
 * Contrato con el backend — /api/contacto NO se toca:
 * - Envia el MISMO FormData al MISMO endpoint que enviaba el formulario.
 * - `servicio` y `urgencia` viajan con un valor de las listas cerradas que
 *   el Worker valida (SERVICIOS y URGENCIAS en src/pages/api/contacto.ts).
 *   Las etiquetas que ve el visitante se mapean a esos valores, y la etiqueta
 *   literal se conserva dentro del resumen: no se pierde nada.
 * - `empresa` y `direccion` van vacias: el asistente no las pregunta, y el
 *   formulario anterior ya las aceptaba vacias.
 * - `website` es el honeypot del formulario anterior, conservado.
 * - No se recoge ningun dato que el formulario no recogiera ya.
 *
 * Por que cerrar no borra nada: la ventana se oculta con `visibility`, no se
 * desmonta. El DOM de la conversacion sigue en pie, asi que minimizar y
 * reabrir dentro de la misma visita conserva lo respondido sin necesidad de
 * guardar estado en ningun sitio.
 *
 * Accesibilidad. La modalidad DEPENDE DEL ANCHO, porque lo que la ventana es
 * depende del ancho:
 * - En escritorio es una ventana de esquina y NO es modal: `role="dialog"` sin
 *   `aria-modal`, el fondo se deja intacto y el foco puede salir.
 * - Por debajo de 640 px cubre la pantalla, asi que ahi SI es modal: los
 *   hermanos de <body> se marcan `inert` —que es lo que contiene el foco, sin
 *   necesidad de una trampa propia—, se bloquea el scroll del documento y solo
 *   entonces se declara `aria-modal`. Declararlo sin contener el foco seria
 *   mentir sobre lo que hace; contenerlo con `inert` lo vuelve cierto.
 * - La burbuja declara `aria-expanded` y `aria-controls`.
 * - Al abrir, el foco entra en la ventana; al cerrar vuelve a la burbuja, pero
 *   solo si estaba dentro. La ventana tiene `tabindex="-1"` para servir de
 *   ancla cuando hay que reubicar el foco sin llevarlo a un control accionable.
 * - Esc cierra, y decide con `e.target` y no con el foco vivo.
 * - Cerrada, `visibility: hidden` la saca del orden de tabulacion y del arbol
 *   de accesibilidad: no hace falta `hidden`.
 * - Cada opcion es un <button> real, navegable por teclado.
 * - El log es aria-live; la burbuja de «escribiendo» queda aria-hidden.
 * - prefers-reduced-motion: sin animacion de apertura ni de tipeo.
 * - Sin JavaScript: la burbuja se oculta y en su sitio queda un enlace flotante
 *   a WhatsApp, mas el de la seccion de contacto.
 *
 * Presupuesto de JS: las clases que el script necesita las LEE de los nodos
 * que pinta el servidor, o las clona de <template>. Asi hay una sola copia de
 * cada cadena de Tailwind y las dos mitades no se pueden desincronizar.
 */
const WA_NUMERO = "51970130174";
const WA_FALLBACK = `https://wa.me/${WA_NUMERO}?text=Hola%2C%20me%20interesa%20cotizar%20un%20proyecto`;

const CATEGORIAS = [
	"Instalaciones Eléctricas",
	"Seguridad y Cámaras",
	"Redes y Telecomunicaciones",
	"Obras y Remodelación",
	"Impresión 3D y Prototipos",
	"Consultoría Técnica",
];

const anillo =
	"focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-darker";
/* Las opciones son pildoras que envuelven en filas, como las respuestas rapidas
   de una app de mensajeria, y no botones de ancho completo apilados: las seis
   categorias tienen que caber junto al saludo sin scroll al abrir. */
/* `py-2` deja el chip en 36 px de alto. Con 32 px y 6 px entre filas, un dedo que
   cae justo debajo de un chip selecciona el de la fila siguiente, y el automata
   avanza de paso SIN confirmacion: eso graba una categoria equivocada en el lead,
   que es la misma corrupcion que causaba la carrera de los 420 ms por otra via. */
const claseOpcion = `inline-flex items-center rounded-full border border-white/15 bg-dark px-3 py-2 text-[13px] leading-snug text-white transition-colors hover:border-primary hover:bg-primary/10 ${anillo}`;
/* Ejes separados: 6 px entre chips de la misma fila, 8 px entre filas. */
const claseChips = "flex flex-wrap gap-x-1.5 gap-y-2";
const clasePrimario = `rounded-full bg-primary px-4 py-1.5 text-[13px] font-semibold text-darker transition-opacity hover:opacity-90 ${anillo}`;
const claseSecundario = `rounded-full border border-white/15 bg-dark px-4 py-1.5 text-[13px] text-white transition-colors hover:border-primary ${anillo}`;
/* Burbujas de chat: esquinas asimetricas por el lado del hablante. */
const claseFilaBot = "as-msg flex items-end gap-2";
const claseAvatar = "mb-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary/15 text-[10px] font-bold text-primary";
const claseBot = "max-w-[calc(100%-2rem)] rounded-2xl rounded-bl-sm bg-dark px-3.5 py-2 text-sm leading-relaxed text-white";
/* `w-fit` es lo que hace que la burbuja del visitante ABRACE su texto. Un <p> es
   un bloque: con width auto rellena, y `max-w-[80%]` lo clava justo en el 80 %,
   asi que un «Casa» salia como una barra cian de 280 px con la palabra pegada a
   la izquierda. La del bot no tenia el problema porque es item flex de la fila
   del avatar. */
const claseMia = "as-msg ml-auto w-fit max-w-[80%] rounded-2xl rounded-br-sm bg-primary/20 px-3.5 py-2 text-sm leading-relaxed text-white";
const claseInput = `w-full rounded-full border border-white/15 bg-dark px-4 py-2 text-sm text-white placeholder:text-silver/50 ${anillo}`;
---

<noscript>
	{/* Sin JavaScript la burbuja seria un boton muerto. Se oculta y en su sitio
	    queda el enlace de WhatsApp, que es lo que habia antes aqui. */}
	<style>#as-raiz { display: none; }</style>
	<a
		href={WA_FALLBACK}
		target="_blank"
		rel="noopener"
		aria-label="Escríbenos por WhatsApp"
		class="fixed bottom-5 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-primary shadow-lg shadow-black/40 sm:bottom-6 sm:right-6"
	>
		<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" class="text-darker" aria-hidden="true">
			<path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.57-.49-.5-.67-.5h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.47s1.06 2.87 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35z"></path>
			<path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.75 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 18.13h-.01c-1.49 0-2.95-.4-4.22-1.16l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 0 1-1.26-4.39c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.42a8.17 8.17 0 0 1 2.41 5.82c0 4.54-3.69 8.25-8.19 8.25z"></path>
		</svg>
	</a>
</noscript>

<div id="as-raiz" data-wa={WA_NUMERO}>
	<button
		id="as-burbuja"
		type="button"
		aria-expanded="false"
		aria-controls="as-ventana"
		aria-label="Abrir el asistente de TOGUCHI"
		class={`flex items-center justify-center rounded-full bg-primary shadow-lg shadow-black/40 transition-opacity hover:opacity-90 ${anillo}`}
	>
		<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" class="text-darker" aria-hidden="true">
			<polygon points="12,1 23,6.5 23,17.5 12,23 1,17.5 1,6.5" stroke="currentColor" stroke-width="1.8" />
			<circle cx="8" cy="12" r="1.3" fill="currentColor" />
			<circle cx="12" cy="12" r="1.3" fill="currentColor" />
			<circle cx="16" cy="12" r="1.3" fill="currentColor" />
		</svg>
	</button>

	<div id="as-ventana" role="dialog" aria-labelledby="as-titulo" tabindex="-1" class="flex-col overflow-hidden rounded-xl border border-white/10 bg-darker shadow-2xl shadow-black/60">
		<div class="flex shrink-0 items-center gap-2.5 border-b border-white/10 px-3.5 py-2.5">
			<span aria-hidden="true" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary/15 text-xs font-bold text-primary">T</span>
			<div class="min-w-0 flex-1">
				<p id="as-titulo" class="text-sm font-semibold leading-tight text-white">Asistente TOGUCHI</p>
				<p id="as-subtitulo" class="truncate text-[11px] leading-tight text-silver">No manejo precios ni plazos</p>
			</div>
			<button
				id="as-cerrar"
				type="button"
				aria-label="Cerrar el asistente"
				class={`-mr-1 -mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-md text-silver transition-colors hover:bg-white/5 hover:text-white ${anillo}`}
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<path d="M6 6l12 12M18 6L6 18" />
				</svg>
			</button>
		</div>

		<div class="shrink-0 px-3.5 pt-2">
			<div class="flex items-center justify-between gap-4">
				<p id="as-paso" class="text-[11px] text-silver">Paso 1 de 7</p>
				<button
					id="as-volver"
					type="button"
					hidden
					class={`rounded text-xs font-medium text-silver underline decoration-silver/40 underline-offset-4 transition-colors hover:text-primary ${anillo}`}
				>Volver</button>
			</div>
			<div
				id="as-barra"
				role="progressbar"
				aria-label="Avance del asistente"
				aria-valuemin="0"
				aria-valuemax="7"
				aria-valuenow="1"
				class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-white/10"
			>
				<div id="as-barra-fill" class="h-full rounded-full bg-primary transition-[width] duration-300" style="width: 14%"></div>
			</div>
		</div>

		{/* UN SOLO contenedor que scrollea. Los mensajes y las opciones viven
		    dentro, como en una app de mensajeria; antes las opciones tenian su
		    propio scroll y salian dos barras anidadas. El log sigue siendo el
		    unico aria-live, para que pintar opciones no se anuncie. */}
		<div id="as-hilo" class="min-h-0 flex-1 overflow-y-auto px-3.5 py-3">
			<div id="as-log" role="log" aria-live="polite" aria-relevant="additions" class="space-y-2.5">
				<div class={claseFilaBot}>
					<span aria-hidden="true" class={claseAvatar}>T</span>
					<p class={claseBot}>Hola. Soy el asistente de TOGUCHI Ingeniería &amp; Servicios. ¿Con qué te ayudamos?</p>
				</div>
			</div>

			<div id="as-respuesta" class="mt-3">
				<div class={claseChips}>
					{CATEGORIAS.map((c) => <button type="button" data-cat={c} class={claseOpcion}>{c}</button>)}
				</div>
			</div>

			<p class="mt-3 text-[11px] leading-relaxed text-silver/70">
				Usamos tus datos solo para responderte esta consulta.&nbsp;
				<a href={WA_FALLBACK} target="_blank" rel="noopener" class="text-silver underline decoration-silver/40 underline-offset-2 hover:text-primary">Prefiero escribir por WhatsApp</a>
			</p>
		</div>

		{/* Plantillas que el script clona. Asi cada cadena de Tailwind existe una sola vez. */}
		<template id="as-tpl">
			<div data-t="bot" class={claseFilaBot}>
				<span aria-hidden="true" class={claseAvatar}>T</span>
				<p class={claseBot}></p>
			</div>
			<p data-t="mia" class={claseMia}></p>
			<input data-t="input" class={claseInput} autocomplete="off" />
			<button data-t="primario" type="button" class={clasePrimario}></button>
			<button data-t="secundario" type="button" class={claseSecundario}></button>
			<p data-t="error" role="alert" class="mt-2 text-xs text-red-400"></p>
			<p data-t="resumen" class="whitespace-pre-line rounded-lg border border-white/10 bg-dark px-4 py-3 text-sm leading-relaxed text-silver"></p>
			<p data-t="nota" class="text-xs leading-relaxed text-silver"></p>
		</template>

		<input type="text" name="website" id="as-website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
	</div>
</div>

<style is:global>
	/* La burbuja respeta el area segura del movil para no tapar nada ni quedar
	   bajo la barra de gestos. */
	#as-burbuja {
		position: fixed;
		z-index: 50;
		right: max(1.25rem, env(safe-area-inset-right));
		bottom: max(1.25rem, env(safe-area-inset-bottom));
		height: 3.5rem;
		width: 3.5rem;
	}

	/* Movil es la base y escritorio la excepcion, como el resto del sitio. Dos
	   consultas complementarias (max-width: 639px / min-width: 640px) dejan un
	   hueco en anchos fraccionarios —639.5 px con zoom o DPR raro— donde no
	   aplica ninguna y la ventana queda sin insets ni tamaño. */
	#as-ventana {
		position: fixed;
		z-index: 60;
		display: flex;
		left: max(0.5rem, env(safe-area-inset-left));
		right: max(0.5rem, env(safe-area-inset-right));
		bottom: max(0.5rem, env(safe-area-inset-bottom));
		/* Deja visible la barra del sistema. */
		top: calc(max(0.5rem, env(safe-area-inset-top)) + 1.5rem);
		visibility: hidden;
		opacity: 0;
		transform: translateY(10px) scale(0.98);
		transform-origin: bottom right;
		transition: opacity 0.18s ease-out, transform 0.18s ease-out, visibility 0.18s;
		/* Sin esto, arrastrar dentro del chat encadena al documento y en Chrome
		   Android dispara el pull-to-refresh: la pagina recarga y la
		   conversacion, que solo vive en el DOM, se pierde. */
		overscroll-behavior: contain;
	}

	#as-raiz.as-abierto #as-ventana {
		visibility: visible;
		opacity: 1;
		transform: none;
	}

	/* El hilo es el UNICO contenedor con scroll de la ventana. Antes el area de
	   opciones tenia el suyo y salian dos barras anidadas; ademas, con el pie
	   fijo, en una ventana baja su contenido se recortaba. Con un solo scroller
	   todo es alcanzable con el mismo gesto y no hay nada que recortar. */
	#as-hilo {
		display: flex;
		flex-direction: column;
		overscroll-behavior: contain;
		scrollbar-width: thin;
		scrollbar-color: rgb(84 210 226 / 0.35) transparent;
	}

	/* Ancla la conversacion al fondo mientras sobra sitio, como una app de
	   mensajeria, en lugar de dejarla pegada arriba con el hueco debajo. El
	   margen automatico se resuelve a 0 en cuanto el contenido desborda, asi que
	   el scroll sigue funcionando y no recorta por arriba —que es lo que pasa si
	   se usa justify-content: flex-end en un contenedor que scrollea—. */
	#as-log {
		margin-top: auto;
	}

	#as-hilo::-webkit-scrollbar {
		width: 6px;
	}

	#as-hilo::-webkit-scrollbar-track {
		background: transparent;
	}

	#as-hilo::-webkit-scrollbar-thumb {
		background: rgb(84 210 226 / 0.35);
		border-radius: 3px;
	}

	#as-hilo::-webkit-scrollbar-thumb:hover {
		background: rgb(84 210 226 / 0.55);
	}

	/* Entrada de cada burbuja, breve y hacia arriba. */
	@keyframes as-entra {
		from { opacity: 0; transform: translateY(6px); }
		to { opacity: 1; transform: none; }
	}

	.as-msg {
		animation: as-entra 0.18s ease-out both;
	}

	/* Abierta, la ventana cubre la pantalla en movil: la burbuja se retira del
	   orden de tabulacion en lugar de quedar debajo, inalcanzable. */
	#as-raiz.as-abierto #as-burbuja {
		visibility: hidden;
	}

	/* Escritorio: ventana anclada sobre la burbuja, y la burbuja sigue a la vista. */
	@media (min-width: 640px) {
		#as-ventana {
			left: auto;
			top: auto;
			right: max(1.25rem, env(safe-area-inset-right));
			bottom: calc(max(1.25rem, env(safe-area-inset-bottom)) + 4.25rem);
			width: 380px;
			/* dvh y no vh: en movil vh cuenta la barra del navegador.
			   El tercer termino es el que GARANTIZA que la ventana cabe: con solo
			   min(620px, 82dvh) y un desplazamiento inferior de 5,5rem, por debajo
			   de unos 489 px de alto de viewport el borde superior caia en negativo
			   y `overflow-hidden` recortaba la cabecera con el boton de cerrar
			   dentro. Un telefono en horizontal entra por aqui, porque entra por
			   ancho: a 390 px de alto se perdian 18 px. */
			height: min(620px, 82dvh, calc(100dvh - 7rem));
		}

		#as-raiz.as-abierto #as-burbuja {
			visibility: visible;
		}
	}

	/* El candado de scroll del asistente. Va por clase y no por estilo en linea
	   para no compartir ranura con el menu movil de Nav. */
	body.as-bloqueado {
		overflow: hidden;
	}

	/* Ventana muy baja: se recupera alto quitando el subtitulo y el bloque de
	   progreso de la cabecera. Con un solo scroller ya no hay nada que se
	   recorte, asi que esto es solo holgura. */
	@media (max-height: 340px) {
		#as-subtitulo { display: none; }
	}

	@media (prefers-reduced-motion: reduce) {
		#as-ventana { transition: none; }
		#as-barra-fill { transition: none; }
		.as-msg { animation: none; }
	}
</style>

<script>
	const raiz = document.getElementById("as-raiz");

	if (raiz) {
		const WA = raiz.dataset.wa;
		const burbuja = document.getElementById("as-burbuja");
		const ventana = document.getElementById("as-ventana");
		const cerrarBtn = document.getElementById("as-cerrar");
		const log = document.getElementById("as-log");
		const hilo = document.getElementById("as-hilo");
		const zona = document.getElementById("as-respuesta");
		const pasoTxt = document.getElementById("as-paso");
		const barra = document.getElementById("as-barra");
		const relleno = document.getElementById("as-barra-fill");
		const volver = document.getElementById("as-volver");
		const honeypot = document.getElementById("as-website");
		const tpl = document.getElementById("as-tpl").content;

		const sinMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		/* Clona una plantilla del servidor: una sola copia de cada clase. */
		const nodo = (t) => tpl.querySelector(`[data-t="${t}"]`).cloneNode(true);
		const claseOpcion = zona.querySelector("[data-cat]").className;
		/* La misma cadena que pinto el servidor: una sola copia. */
		const CHIPS = zona.firstElementChild.className;

		/* El hilo es el UNICO contenedor con scroll, asi que llevarlo al fondo es
		 * una sola funcion y se llama tras cada mensaje, cada tanda de opciones y
		 * cada error: el visitante nunca deberia tener que scrollear para ver lo
		 * ultimo. */
		function alFondo() {
			hilo.scrollTop = hilo.scrollHeight;
		}

		/* ---------- Abrir y cerrar ----------
		 * Cerrar solo oculta: el DOM de la conversacion no se desmonta, asi que
		 * reabrir dentro de la misma visita conserva lo respondido.
		 */
		let abierto = false;
		let modal = false;
		/* El MISMO umbral que decide el layout en el CSS, no uno paralelo:
		 * `max-width: 639px` y `min-width: 640px` no son complementarios, y en un
		 * ancho fraccionario —639,5 px con zoom— la ventana se pintaba a pantalla
		 * completa sin ser modal, con el fondo tabulable detras. */
		const escritorio = window.matchMedia("(min-width: 640px)");
		/* `inert` es lo que contiene el foco. Sin soporte no se declara aria-modal,
		 * porque entonces si seria la mentira que este encabezado se prohibe. */
		const hayInert = "inert" in HTMLElement.prototype;
		const SEL_FOCO = "button:not([disabled]), input:not([disabled]), a[href]";

		/* En movil la ventana cubre la pantalla, asi que ahi SI es modal y se
		 * comporta como tal: el fondo se marca `inert` —fuera del orden de
		 * tabulacion, fuera del arbol de accesibilidad y sin recibir clics—, se
		 * declara aria-modal y se bloquea el scroll del documento. En escritorio
		 * es una ventana de esquina y no se toca nada del fondo.
		 *
		 * `modal` es la bandera de propiedad y es imprescindible: el menu movil
		 * de Nav escribe `body.style.overflow` del MISMO body, asi que vaciarlo
		 * al cerrar le quitaba su candado y el fondo volvia a scrollear con el
		 * menu abierto. Aqui solo se escribe cuando este componente cambia de
		 * estado, y se restaura el valor previo en lugar de vaciarlo.
		 *
		 * Se reevalua tambien al cruzar el breakpoint: girar el telefono con la
		 * ventana abierta dejaba el fondo inerte y sin scroll mientras la ventana
		 * se encogia a la esquina, o al contrario, sin modalidad cuando ya
		 * cubria la pantalla. */
		function aplicarModalidad() {
			const debe = abierto && !escritorio.matches;
			if (debe === modal) return;
			modal = debe;
			for (const el of document.body.children) {
				if (el !== raiz) el.inert = debe;
			}
			/* Una clase propia en <body>, NO `body.style.overflow`: esa ranura la
			 * escribe tambien el menu movil de Nav. Guardar su valor y restaurarlo
			 * hacia que el asistente reescribiera un "hidden" ajeno al salir de
			 * modalidad y dejara la pagina entera sin scroll con todo cerrado y sin
			 * forma de recuperarla. Con una clase, los dos candados se suman y
			 * ninguno pisa al otro: un estilo en linea de Nav gana mientras exista,
			 * y al retirarlo manda la clase si el asistente sigue abierto. */
			document.body.classList.toggle("as-bloqueado", debe);
			if (debe && hayInert) ventana.setAttribute("aria-modal", "true");
			else ventana.removeAttribute("aria-modal");
			/* Al volverse modal el fondo pasa a inert: si el foco estaba ahi, el
			 * navegador lo suelta a <body>, y entonces Escape —que decide con
			 * e.target— ya no podia cerrar la ventana. Camino real: abrir en
			 * escritorio, tocar la pagina detras y girar el telefono. */
			if (debe && !ventana.contains(document.activeElement)) ventana.focus();
		}

		escritorio.addEventListener("change", aplicarModalidad);

		function abrir() {
			if (abierto) return;
			/* Reabrir una conversacion ya enviada empieza una nueva, en lugar de
			 * mostrar un final sin salida. */
			if (i >= PASOS.length) reiniciar();
			abierto = true;
			raiz.classList.add("as-abierto");
			burbuja.setAttribute("aria-expanded", "true");
			aplicarModalidad();
			alFondo();
			/* Excluye lo deshabilitado: con un envio en vuelo el primer boton es
			 * «Enviando…», su focus() no hace nada, y en movil el foco se quedaba
			 * en la burbuja que esta misma funcion acaba de ocultar. */
			(zona.querySelector(SEL_FOCO) || cerrarBtn).focus();
			if (!ventana.contains(document.activeElement)) ventana.focus();
		}

		/* `desde` es el nodo desde el que se pidio cerrar. Se recibe como
		 * argumento y no se lee de document.activeElement porque para cuando
		 * corre este handler otro —el de Nav— pudo haber movido ya el foco. */
		function cerrar(desde) {
			if (!abierto) return;
			/* Solo se recupera el foco si estaba dentro: devolverlo siempre lo
			 * teletransportaba a la esquina desde donde estuviera el visitante. */
			/* `desde` es una pista ADICIONAL, no la unica fuente: en Safari un clic
			 * sobre un boton no le da el foco, asi que al pulsar la burbuja para
			 * minimizar el foco seguia dentro de la ventana y se quedaba atrapado
			 * en un subarbol que pasa a `visibility: hidden`. */
			const dentro = ventana.contains(desde) || ventana.contains(document.activeElement);
			abierto = false;
			raiz.classList.remove("as-abierto");
			burbuja.setAttribute("aria-expanded", "false");
			aplicarModalidad();
			if (dentro) burbuja.focus();
		}

		burbuja.addEventListener("click", () => (abierto ? cerrar(burbuja) : abrir()));
		cerrarBtn.addEventListener("click", () => cerrar(cerrarBtn));

		/* Escape solo actua si la pulsacion ocurrio DENTRO del asistente, y la
		 * decision se toma con `e.target`, que queda fijado al despacharse el
		 * evento. Leer document.activeElement no servia: el menu movil de Nav
		 * tiene su propio keydown en document, corre antes, mueve el foco a su
		 * boton y ninguno de los dos detiene la propagacion, de modo que cuando
		 * llegaba este handler el foco ya estaba fuera y Escape no cerraba nunca
		 * entre 640 y 767 px. */
		document.addEventListener(
			"keydown",
			(e) => {
				if (e.key !== "Escape" || !abierto) return;
				if (!ventana.contains(e.target) && e.target !== burbuja) return;
				/* En CAPTURA y deteniendo la propagacion: el keydown de Nav esta en
				 * burbujeo y se registro antes, asi que sin esto un Escape dentro del
				 * chat cerraba ademas su menu movil. */
				e.stopPropagation();
				cerrar(e.target);
			},
			true
		);

		/* Segundo punto de entrada: el boton de la seccion de contacto. Un solo
		 * asistente, dos sitios desde donde abrirlo. */
		document.addEventListener("click", (e) => {
			if (e.target.closest("[data-asistente-abrir]")) abrir();
		});

		/* ---------- Catalogo del flujo ----------
		 * `servicio` es el valor que valida el Worker. `refina` deja que una
		 * respuesta concreta apunte a un bucket mas preciso del catalogo, que
		 * tambien es un valor valido del Worker.
		 */
		const CATS = {
			"Instalaciones Eléctricas": {
				servicio: "Instalaciones eléctricas",
				refina: { "Tablero eléctrico": "Tableros y control industrial" },
				q1: {
					texto: "¿Qué necesitas exactamente?",
					campo: "Trabajo",
					ops: ["Tablero eléctrico", "Recableado", "Pozo a tierra", "Alumbrado", "Otro / no estoy seguro"],
				},
				q2: {
					texto: "¿En qué tipo de inmueble sería?",
					campo: "Inmueble",
					ops: ["Casa", "Local comercial", "Oficina", "Industria"],
				},
			},
			"Seguridad y Cámaras": {
				servicio: "CCTV y seguridad electrónica",
				refina: { "Domótica": "Domótica e IoT" },
				q1: {
					texto: "¿Qué sistema te interesa?",
					campo: "Sistema",
					ops: ["CCTV / cámaras", "Alarma", "Control de acceso", "Domótica"],
				},
				q2: {
					texto: "¿Cuántos puntos necesitas, aproximadamente?",
					campo: "Puntos aprox.",
					ops: ["1 a 4", "5 a 8", "9 a 16", "Más de 16", "No lo sé todavía"],
				},
			},
			"Redes y Telecomunicaciones": {
				servicio: "Redes y cableado estructurado",
				q1: {
					texto: "¿Qué trabajo necesitas?",
					campo: "Trabajo",
					ops: ["Cableado estructurado", "Fibra óptica", "Rack y gabinete", "Wifi / cobertura"],
				},
				q2: {
					texto: "¿Cuántos puntos de red, aproximadamente?",
					campo: "Puntos aprox.",
					ops: ["1 a 4", "5 a 8", "9 a 16", "Más de 16", "No lo sé todavía"],
				},
			},
			"Obras y Remodelación": {
				servicio: "Remodelación y acondicionamiento",
				q1: {
					texto: "¿Qué tipo de trabajo es?",
					campo: "Trabajo",
					ops: ["Recuperación de espacios", "Pintura", "Drywall", "Acabados"],
				},
				q2: {
					texto: "¿Qué área aproximada tiene?",
					campo: "Área aprox.",
					ops: ["Menos de 20 m²", "20 a 50 m²", "50 a 120 m²", "Más de 120 m²", "No lo sé todavía"],
				},
			},
			"Impresión 3D y Prototipos": {
				servicio: "Mecatrónica y prototipado",
				q1: {
					texto: "¿Qué necesitas fabricar?",
					campo: "Encargo",
					ops: ["Una pieza", "Un prototipo", "Escaneo 3D", "Serie corta"],
				},
				q2: {
					texto: "¿Tienes el archivo 3D?",
					campo: "Archivo 3D",
					ops: ["Sí, tengo STL o STEP", "No, solo plano o foto", "No tengo nada aún"],
				},
			},
			"Consultoría Técnica": {
				servicio: "Consultoría e ingeniería técnica",
				q1: {
					texto: "¿Qué tipo de evaluación necesitas?",
					campo: "Evaluación",
					ops: ["Diagnóstico", "Mediciones", "Revisión de instalación"],
				},
				q2: {
					texto: "¿Es para un trámite formal?",
					campo: "Trámite formal",
					ops: ["Sí", "No", "No estoy seguro"],
				},
			},
		};

		/* Las 4 etiquetas de urgencia se mapean a los 3 valores que acepta el
		 * Worker. La etiqueta literal se conserva en el resumen. */
		const URGENCIAS = {
			"Es urgente": "Lo antes posible",
			"Esta semana": "Lo antes posible",
			"Este mes": "Dentro de este mes",
			"Solo estoy cotizando": "Aún estoy cotizando",
		};

		const PASOS = ["categoria", "q1", "q2", "urgencia", "nombre", "whatsapp", "distrito", "resumen"];
		const TEXTOS = {
			nombre: ["¿Cuál es tu nombre?", "Tu nombre", "Nombre y apellido", "text", ""],
			whatsapp: ["¿A qué número de WhatsApp te contactamos?", "Tu WhatsApp", "9XXXXXXXX", "tel", "numeric"],
			distrito: ["¿En qué distrito es el trabajo?", "Tu distrito", "Distrito", "text", ""],
		};

		const r = { categoria: "", q1: "", q2: "", urgencia: "", nombre: "", whatsapp: "", distrito: "" };
		let i = 0;
		let interactuado = false;
		let enviando = false;
		/* Sube con cada cambio de paso. Un callback de `bot()` solo pinta si su
		 * generacion sigue siendo la vigente. */
		let gen = 0;

		/* Cuantos mensajes habia en el log antes de pintar cada paso. Es lo que
		 * permite que "Volver" deje el log exactamente como estaba: retirar un
		 * numero fijo de burbujas no sirve, porque cada paso añade una cantidad
		 * distinta (el resumen añade tres y el primero, ninguna). */
		const marcas = [];

		/* ---------- Pintado ---------- */

		function burbujaMsg(texto, mia) {
			const n = nodo(mia ? "mia" : "bot");
			/* La del bot es una fila con avatar; el texto va en su <p>. */
			(mia ? n : n.querySelector("p")).textContent = texto;
			log.appendChild(n);
			alFondo();
		}

		/* Mensaje del asistente. Con movimiento reducido entra de golpe.
		 *
		 * El contador de generacion es lo que impide que un callback agendado
		 * para un paso pinte sus controles cuando el paso ya cambio. Sin el,
		 * pulsar «Volver» durante el retardo dejaba que el callback pendiente
		 * pintara las opciones de la pregunta anterior encima del paso nuevo, y
		 * al elegir una, `r.categoria` acababa con un valor que no es clave de
		 * CATS: `pintarPaso` lanzaba TypeError y el asistente quedaba muerto
		 * para el resto de la visita.
		 */
		function bot(texto, luego) {
			if (sinMovimiento) {
				burbujaMsg(texto, false);
				luego();
				return;
			}
			const mia = gen;
			const t = nodo("bot");
			t.setAttribute("aria-hidden", "true");
			t.querySelector("p").textContent = "escribiendo…";
			log.appendChild(t);
			alFondo();
			setTimeout(() => {
				if (mia !== gen) return;
				t.remove();
				burbujaMsg(texto, false);
				luego();
			}, 420);
		}

		function progreso() {
			const n = Math.min(i + 1, 7);
			pasoTxt.textContent = `Paso ${n} de 7`;
			barra.setAttribute("aria-valuenow", String(n));
			relleno.style.width = `${Math.round((n / 7) * 100)}%`;
			volver.hidden = i === 0 || i > 7;
		}

		/* El paso final solo pinta un <a> y un <p>: con el selector limitado a
		 * button/input no habia nada que enfocar y el foco se quedaba en <body>,
		 * a un recorrido entero del sitio del boton de WhatsApp. El respaldo es
		 * el mismo que ya usaba abrir(). */
		function enfocar() {
			if (!interactuado || !abierto) return;
			(zona.querySelector(SEL_FOCO) || cerrarBtn).focus();
			if (!ventana.contains(document.activeElement)) ventana.focus();
		}

		function opciones(lista) {
			zona.textContent = "";
			const grid = document.createElement("div");
			grid.className = CHIPS;
			lista.forEach((op) => {
				const b = document.createElement("button");
				b.type = "button";
				b.textContent = op;
				b.dataset.op = op;
				b.className = claseOpcion;
				grid.appendChild(b);
			});
			zona.appendChild(grid);
			alFondo();
			enfocar();
		}

		function campoTexto(paso) {
			const [, etiqueta, marca, tipo, modo] = TEXTOS[paso];
			zona.textContent = "";
			const f = document.createElement("form");
			/* Campo y boton en la misma fila, como la barra de escribir de una app
			 * de mensajeria. */
			f.className = "flex items-center gap-1.5";
			f.noValidate = true;

			const inp = nodo("input");
			inp.type = tipo;
			inp.placeholder = marca;
			if (modo) inp.inputMode = modo;
			inp.setAttribute("aria-label", etiqueta);

			const b = nodo("primario");
			b.type = "submit";
			b.textContent = "Continuar";
			b.className += " shrink-0";

			const err = nodo("error");
			f.append(inp, b);
			zona.append(f, err);
			f.addEventListener("submit", (e) => {
				e.preventDefault();
				responderTexto(inp.value.trim(), err);
			});
			alFondo();
			enfocar();
		}

		/* ---------- Resumen ---------- */

		function resumenTexto() {
			const cat = CATS[r.categoria];
			return [
				`Consulta por el asistente del sitio — ${r.categoria}`,
				"",
				`${cat.q1.campo}: ${r.q1}`,
				`${cat.q2.campo}: ${r.q2}`,
				`Urgencia indicada: ${r.urgencia}`,
				`Distrito: ${r.distrito}`,
				"",
				"Recogido por el asistente guiado del sitio. No se entregaron precios ni plazos.",
			].join("\n");
		}

		function servicioFinal() {
			const cat = CATS[r.categoria];
			return (cat.refina && cat.refina[r.q1]) || cat.servicio;
		}

		function botonWa(etiqueta) {
			const a = document.createElement("a");
			a.href = `https://wa.me/${WA}?text=${encodeURIComponent(`Hola, soy ${r.nombre}. ${resumenTexto()}`)}`;
			a.target = "_blank";
			a.rel = "noopener";
			a.textContent = etiqueta;
			a.className = nodo("primario").className;
			return a;
		}

		/* ---------- Pasos ---------- */

		function pintarPaso() {
			/* Invalida cualquier callback pendiente y retira los controles del
			 * paso anterior: durante los 420 ms del tipeo seguian en el DOM,
			 * activos y con el foco encima, y `responderOpcion` ya leia la `i`
			 * avanzada. Un segundo toque —el visitante que se corrige— contestaba
			 * la pregunta siguiente con una opcion de la lista anterior. */
			gen += 1;
			/* Vaciar la zona quita del DOM el control enfocado y el foco caia a
			 * <body>: durante los 420 ms del tipeo Escape dejaba de cerrar y Tab
			 * se salia del dialogo. Se reubica en la propia ventana, que es un
			 * ancla no accionable (tabindex="-1"). */
			if (zona.contains(document.activeElement)) ventana.focus();
			zona.textContent = "";
			progreso();
			marcas[i] = log.childElementCount;
			const paso = PASOS[i];
			const cat = CATS[r.categoria] || null;

			/* Una categoria fuera de catalogo no se desreferencia nunca: se vuelve
			 * al principio. Una sola recursion, porque al volver el paso ya es
			 * "categoria" y la guarda no se cumple. */
			if (!cat && paso !== "categoria") {
				i = 0;
				r.categoria = "";
				pintarPaso();
				return;
			}

			if (paso === "categoria") {
				opciones(Object.keys(CATS));
			} else if (paso === "q1" || paso === "q2") {
				bot(cat[paso].texto, () => opciones(cat[paso].ops));
			} else if (paso === "urgencia") {
				bot("¿Para cuándo lo necesitas?", () => opciones(Object.keys(URGENCIAS)));
			} else if (paso === "resumen") {
				bot("Esto es lo que voy a enviar al ingeniero:", () => {
					const pre = nodo("resumen");
					pre.textContent = `${resumenTexto()}\n\nNombre: ${r.nombre}\nWhatsApp: ${r.whatsapp}`;
					log.appendChild(pre);
					alFondo();
					confirmar();
				});
			} else {
				bot(TEXTOS[paso][0], () => campoTexto(paso));
			}
		}

		function confirmar() {
			zona.textContent = "";
			const fila = document.createElement("div");
			fila.className = "flex flex-wrap items-center gap-1.5";

			const enviar = nodo("primario");
			enviar.id = "as-enviar";
			enviar.textContent = "Enviar mi consulta";
			enviar.addEventListener("click", enviarLead);

			const corregir = nodo("secundario");
			corregir.textContent = "Empezar de nuevo";
			corregir.addEventListener("click", reiniciar);

			fila.append(enviar, corregir);
			zona.append(fila, nodo("error"));
			alFondo();
			enfocar();
		}

		async function enviarLead() {
			if (enviando) return;
			enviando = true;
			const btn = document.getElementById("as-enviar");
			const err = zona.querySelector('[role="alert"]');
			/* Desactivar el boton enfocado lo desenfoca, y el foco se quedaba en
			 * <body> durante todo el fetch —segundos en red movil—, con Escape
			 * muerto y el visitante de teclado aparcado al principio del
			 * documento. */
			if (zona.contains(document.activeElement)) ventana.focus();
			btn.disabled = true;
			btn.textContent = "Enviando…";

			const fd = new FormData();
			fd.append("nombre", r.nombre);
			fd.append("empresa", "");
			fd.append("whatsapp", r.whatsapp);
			fd.append("servicio", servicioFinal());
			fd.append("distrito", r.distrito);
			fd.append("direccion", "");
			fd.append("urgencia", URGENCIAS[r.urgencia]);
			fd.append("mensaje", resumenTexto());
			fd.append("website", honeypot.value);

			try {
				const res = await fetch("/api/contacto", { method: "POST", body: fd });
				const data = await res.json();
				if (!data.ok) throw new Error("rechazado");
				cerrarFlujo();
			} catch {
				/* Si el visitante cambio de paso mientras el envio estaba en
				 * vuelo, estos nodos ya no estan en el documento: escribir en
				 * ellos no se veria, y `zona.firstElementChild` puede ser null
				 * porque la zona se vacia al cambiar de paso. */
				const caja = zona.firstElementChild;
				if (caja && !zona.querySelector("a")) caja.appendChild(botonWa("Enviar por WhatsApp"));
				if (err.isConnected) {
					err.textContent = "No se pudo enviar. Reintenta o escríbenos por WhatsApp.";
					/* En una ventana baja el pie es una ventanilla de pocos pixeles y el
					 * aviso quedaba por debajo, sin nada que indicara que estaba ahi. */
					err.scrollIntoView({ block: "nearest" });
				}
				if (btn.isConnected) {
					btn.disabled = false;
					btn.textContent = "Reintentar";
					/* Solo se recupera el foco si no se lo habia llevado el visitante:
					 * en escritorio la ventana no es modal y puede estar navegando la
					 * pagina mientras el envio viaja. */
					if (abierto && (ventana.contains(document.activeElement) || document.activeElement === document.body)) btn.focus();
				}
			} finally {
				enviando = false;
			}
		}

		function cerrarFlujo() {
			i = PASOS.length;
			progreso();
			pasoTxt.textContent = "Listo";
			volver.hidden = true;
			bot(`Gracias, ${r.nombre}. Recibimos tu consulta y te contactamos por WhatsApp.`, () => {
				zona.textContent = "";
				const caja = document.createElement("div");
				caja.className = "flex flex-wrap items-center gap-2";
				const nota = nodo("nota");
				nota.textContent = "Si quieres adelantar, abre el chat con tu resumen ya escrito.";
				caja.append(botonWa("Abrir WhatsApp con mi resumen"), nota);
				zona.appendChild(caja);
				alFondo();
				enfocar();
			});
		}

		function reiniciar() {
			/* Con un envio en vuelo, reiniciar vaciaba `r` y la rama de error
			 * acababa leyendo CATS[""]: TypeError y area de respuesta vacia. */
			if (enviando) return;
			i = 0;
			PASOS.forEach((k) => { if (k in r) r[k] = ""; });
			log.textContent = "";
			burbujaMsg("Empecemos otra vez. ¿Con qué te ayudamos?", false);
			pintarPaso();
		}

		/* ---------- Respuestas ---------- */

		function avanzar(valor) {
			burbujaMsg(valor, true);
			i += 1;
			pintarPaso();
		}

		/* Que opciones son legales en el paso actual. Comprobar pertenencia, y no
		 * solo que el paso admita opciones, es lo que hace que un clic sobre un
		 * control obsoleto no pueda corromper el lead: es un cinturon que no
		 * depende de ninguna temporizacion. */
		function legales(paso) {
			if (paso === "categoria") return Object.keys(CATS);
			if (paso === "urgencia") return Object.keys(URGENCIAS);
			if (paso === "q1" || paso === "q2") {
				const cat = CATS[r.categoria];
				return cat ? cat[paso].ops : [];
			}
			return [];
		}

		function responderOpcion(valor) {
			const paso = PASOS[i];
			if (!legales(paso).includes(valor)) return;
			interactuado = true;
			r[paso] = valor;
			avanzar(valor);
		}

		/* La validacion del cliente ayuda al visitante, no es frontera: el
		 * Worker revalida todo lo que llega. */
		function responderTexto(valor, err) {
			const paso = PASOS[i];
			if (!TEXTOS[paso]) return;
			interactuado = true;
			err.textContent = "";

			if (paso === "whatsapp") {
				const limpio = valor.replace(/[\s()-]/g, "").replace(/^\+?51/, "");
				if (!/^9\d{8}$/.test(limpio)) {
					err.textContent = "Necesito un celular peruano de 9 dígitos que empiece con 9.";
					err.scrollIntoView({ block: "nearest" });
					return;
				}
				r.whatsapp = limpio;
				avanzar(limpio);
				return;
			}

			const max = paso === "nombre" ? 100 : 60;
			const min = paso === "nombre" ? 2 : 3;
			if (valor.length < min || valor.length > max) {
				err.textContent = `Escribe ${paso === "nombre" ? "tu nombre" : "el distrito"} (entre ${min} y ${max} caracteres).`;
				err.scrollIntoView({ block: "nearest" });
				return;
			}
			r[paso] = valor;
			avanzar(valor);
		}

		function atras() {
			/* Mismo cinturon que reiniciar(): cambiar de paso con un envio en
			 * vuelo desprende del DOM los nodos que la rama de error necesita. */
			if (enviando) return;
			if (i === 0) return;
			i -= 1;
			r[PASOS[i]] = "";
			while (log.childElementCount > marcas[i] && log.lastElementChild) log.lastElementChild.remove();
			interactuado = true;
			pintarPaso();
		}

		/* Un solo listener delegado cubre todas las opciones, incluidas las
		 * seis que ya vienen pintadas por el servidor. */
		zona.addEventListener("click", (e) => {
			const b = e.target.closest("button[data-cat], button[data-op]");
			if (b) responderOpcion(b.dataset.cat || b.dataset.op);
		});

		volver.addEventListener("click", atras);
		marcas[0] = log.childElementCount;
		progreso();
	}
</script>
