---

<section id="portafolio" class="scroll-mt-20 bg-darker">
	<div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
		<p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-primary">Portafolio</p>
		<h2 class="max-w-2xl text-3xl font-bold tracking-tight sm:text-4xl">
			Trabajos ejecutados
		</h2>
		<p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-silver">
			Proyectos reales entregados en Lima y Callao. Cada caso muestra el problema encontrado, la solución ejecutada y el resultado.
		</p>

		<div class="mt-16 space-y-20">
			{projects.map((p, i) => (
				<article class="grid grid-cols-1 items-center gap-8 lg:grid-cols-2 lg:gap-12">
					<div class={`gallery relative order-2 ${i % 2 === 1 ? "lg:order-2" : "lg:order-1"}`} data-gallery>
						<div
							class="track flex snap-x snap-mandatory overflow-x-auto rounded-lg border border-white/10"
							data-track
						>
							{p.images.map((img) => (
								<figure class="relative min-w-full snap-center">
									<img
										src={img.src}
										alt={img.alt}
										loading="lazy"
										decoding="async"
										width={p.wide ? 1200 : 900}
										height={p.wide ? 675 : 1200}
										class="w-full"
									/>
									<figcaption class="absolute left-3 top-3 rounded bg-darker/85 px-2.5 py-1 text-xs font-semibold text-primary backdrop-blur">
										{img.label}
									</figcaption>
								</figure>
							))}
						</div>
						{p.images.length > 1 && (
							<div class="mt-3 flex items-center justify-between">
								<div class="flex gap-1.5" data-dots>
									{p.images.map((_, di) => (
										<span class={`h-1.5 rounded-full transition-all ${di === 0 ? "w-5 bg-primary" : "w-1.5 bg-silver/40"}`}></span>
									))}
								</div>
								<div class="flex gap-2">
									<button type="button" data-prev aria-label="Imagen anterior" class="rounded border border-white/15 px-2.5 py-1 text-sm text-silver transition-colors hover:border-primary hover:text-primary">&#8592;</button>
									<button type="button" data-next aria-label="Imagen siguiente" class="rounded border border-white/15 px-2.5 py-1 text-sm text-silver transition-colors hover:border-primary hover:text-primary">&#8594;</button>
								</div>
							</div>
						)}
					</div>

					<div class={`order-1 ${i % 2 === 1 ? "lg:order-1" : "lg:order-2"}`}>
						<div class="flex items-baseline gap-4">
							<span class="font-mono text-sm text-primary/70">{p.num}</span>
							<p class="text-xs uppercase tracking-wider text-silver/70">{p.meta}</p>
						</div>
						<h3 class="mt-2 text-xl font-semibold text-white sm:text-2xl">{p.title}</h3>
						<dl class="mt-5 space-y-3 text-[15px] leading-relaxed">
							<div>
								<dt class="text-xs font-semibold uppercase tracking-wider text-silver/60">Problema</dt>
								<dd class="mt-1 text-silver">{p.problema}</dd>
							</div>
							<div>
								<dt class="text-xs font-semibold uppercase tracking-wider text-silver/60">Solución</dt>
								<dd class="mt-1 text-silver">{p.solucion}</dd>
							</div>
							<div>
								<dt class="text-xs font-semibold uppercase tracking-wider text-silver/60">Resultado</dt>
								<dd class="mt-1 text-white">{p.resultado}</dd>
							</div>
						</dl>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.track {
		scrollbar-width: none;
		-ms-overflow-style: none;
	}
	.track::-webkit-scrollbar {
		display: none;
	}
</style>

<script>
	document.querySelectorAll("[data-gallery]").forEach((gal) => {
		const track = gal.querySelector("[data-track]") as HTMLElement | null;
		const dots = gal.querySelectorAll("[data-dots] span");
		const prev = gal.querySelector("[data-prev]");
		const next = gal.querySelector("[data-next]");
		if (!track) return;

		const total = track.children.length;
		let index = 0;

		function paint() {
			dots.forEach((d, i) => {
				d.className = `h-1.5 rounded-full transition-all ${i === index ? "w-5 bg-primary" : "w-1.5 bg-silver/40"}`;
			});
		}

		function goTo(i: number) {
			index = (i + total) % total;
			track.scrollTo({ left: track.clientWidth * index, behavior: "smooth" });
			paint();
		}

		prev?.addEventListener("click", () => goTo(index - 1));
		next?.addEventListener("click", () => goTo(index + 1));

		let raf: number;
		track.addEventListener("scroll", () => {
			cancelAnimationFrame(raf);
			raf = requestAnimationFrame(() => {
				const i = Math.round(track.scrollLeft / track.clientWidth);
				if (i !== index) {
					index = i;
					paint();
				}
			});
		});
	});
</script>
