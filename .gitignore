# Dependencias
node_modules/
**/node_modules/

# Builds Astro
dist/
**/dist/
.astro/
**/.astro/

# Cloudflare
.wrangler/
**/.wrangler/

# Env / secrets
.env
.env.*
!.env.example

# Editor / SO
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# Logs
npm-debug.log*
*.log

# Notas internas de trabajo. Este repositorio es publico: las instrucciones de
# trabajo y las notas de infraestructura no son parte del sitio y no se
# publican, aunque su contenido sea visible por otra via (los nameservers lo
# son por DNS). La documentacion de infraestructura vive fuera del repo.
CLAUDE.md
Nameservers*.txt

# Paginas que regenera el build de los ejemplos del kit vendorizado.
vendor/anatomy/examples/**/*.html

# Artefactos de las figuras: los regenera figuras/<nombre>/build.mjs. La copia
# publicada vive en apps/landing/public/figuras/ y esa si se versiona.
figuras/**/*.html
figuras/**/*.svg
